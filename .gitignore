# =============================================================================
# .gitignore Template fuer Software Entwicklung Projekte
# Kopieren und als .gitignore im Projektroot ablegen
# Projektspezifische Eintraege am Ende anfuegen
# =============================================================================

# ---- Python ----
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
.wheel-smoke/
wheelhouse/
.tox/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/

# ---- Virtuelle Umgebungen ----
venv/
.venv/
env/
.env/

# ---- BACH Interne Steuerungsdateien (NIEMALS in Git!) ----
AUFGABEN.txt
TEST.txt
TESTS.txt
TESTERGEBNISSE.txt
BUGREPORT.md
DIAGNOSE_REPORT.md
SKILL.md
tmpclaude-*

# ---- Persoenliche / Sensible Daten ----
_USER/
.env
.env.*
credentials.json
client_secret*.json
token.json
*.pem
*.key
*.db
*.sqlite
*.sqlite3
keyring/

# ---- Build-Artefakte & Releases ----
releases/
*.exe
*.msi
*.msix
*.appx
*.spec
!MethodenAnalyser.spec
*.pfx
*.p12
*.cer

# ---- IDE & Editoren ----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Betriebssystem ----
desktop.ini
Thumbs.db
.DS_Store
ehthumbs.db

# ---- Standard-Patterns ----
PLAN.txt
_archive/
_private/
*.log
*.tmp
*.bak

# ---- Projektspezifisch (hier eigene Eintraege anfuegen) ----
DECISIONS.md
PORTIERUNGSPLAN.md
TODO.md
DONE.md

# ---- Multi-Agent & File Locks ----
LOCK
LOCK.*
*.lock
LOCK*.txt
LOCK.permissions.json
uv.lock
!LOCK.md

# ---- Cloud-Sync- & Host-Konfliktdateien ----
*-conflict-*
*.sync-temp-*
*.sync-conflict-*
*.conflict
*-CONFLIT-*
*-WORKSTATION*
*-WORKSTATION-LG*
*-ASUS-GEI*
*-ASUS-GEI.py
* (kopie)*
* (Kopie)*
* (copy)*
* (Copy)*
